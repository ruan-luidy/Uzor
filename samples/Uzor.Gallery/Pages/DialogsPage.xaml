<UserControl
  x:Class="Uzor.Gallery.Pages.DialogsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Uzor.Wpf.Controls;assembly=Uzor.Wpf"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Uzor.Wpf.Icons;assembly=Uzor.Wpf"
  xmlns:uzor="clr-namespace:Uzor.Wpf;assembly=Uzor.Wpf">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <controls:PageHeader Title="Diálogos e avisos" Subtitle="Aviso, confirmação de algo sem volta, erro com detalhes, formulário e os avisos flutuantes." />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,16">
        <TextBlock Style="{StaticResource GallerySection}" Text="DIÁLOGOS" />
        <Border Style="{StaticResource GalleryCard}">
          <WrapPanel>
            <Button Margin="0,0,8,8" Click="Info_Click" Content="Aviso" Style="{StaticResource Action}" />
            <Button Margin="0,0,8,8" Click="Warning_Click" Content="Atenção" Style="{StaticResource Action}" />
            <Button Margin="0,0,8,8" Click="Error_Click" Content="Erro com detalhes" Style="{StaticResource Action}" />
            <Button Margin="0,0,8,8" Click="Confirm_Click" Content="Confirmar exclusão" Style="{StaticResource Action}" />
            <Button Margin="0,0,8,8" Click="Form_Click" Content="Formulário" Style="{StaticResource Action.Primary}" />
          </WrapPanel>
        </Border>

        <TextBlock Style="{StaticResource GallerySection}" Text="AVISOS FLUTUANTES" />
        <Border Style="{StaticResource GalleryCard}">
          <WrapPanel>
            <Button Margin="0,0,8,8" Click="ToastSuccess_Click" Content="Sucesso" Style="{StaticResource Action}" />
            <Button Margin="0,0,8,8" Click="ToastInfo_Click" Content="Informação" Style="{StaticResource Action}" />
            <Button Margin="0,0,8,8" Click="ToastWarning_Click" Content="Atenção" Style="{StaticResource Action}" />
            <Button Margin="0,0,8,8" Click="ToastError_Click" Content="Erro" Style="{StaticResource Action}" />
          </WrapPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
