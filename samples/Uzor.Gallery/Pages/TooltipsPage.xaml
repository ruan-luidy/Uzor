<UserControl
  x:Class="Uzor.Gallery.Pages.TooltipsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Uzor.Wpf.Controls;assembly=Uzor.Wpf"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Uzor.Wpf.Icons;assembly=Uzor.Wpf"
  xmlns:uzor="clr-namespace:Uzor.Wpf;assembly=Uzor.Wpf">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <controls:PageHeader Title="Tooltips" Subtitle="No cartão dos menus, com sombra e quebra de linha; com mais de uma linha, a primeira vira título. Passe o mouse." />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,16">
        <TextBlock Style="{StaticResource GallerySection}" Text="TEXTO" />
        <Border Style="{StaticResource GalleryCard}">
          <WrapPanel>
            <Button Margin="0,0,8,8" Content="Curto" Style="{StaticResource Action}" ToolTip="Buscar desenhos nas pastas" />
            <Button
              Margin="0,0,8,8"
              Content="Com título"
              Style="{StaticResource Action}"
              ToolTip="Aprovado 05/11/2026 14:30&#x0a;Justificativa: o menor preço não atende o prazo da montagem, que começa dia 20." />
          </WrapPanel>
        </Border>

        <TextBlock Style="{StaticResource GallerySection}" Text="CONTEÚDO PRÓPRIO" />
        <Border Style="{StaticResource GalleryCard}">
          <Button
            HorizontalAlignment="Left"
            Content="Cotação"
            Style="{StaticResource Action}">
            <Button.ToolTip>
              <ToolTip>
                <StackPanel MinWidth="200">
                  <TextBlock FontWeight="SemiBold" Text="Beta Tornearia ME" />
                  <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource FontFamily.Numbers}" FontSize="{StaticResource FontSize.Lg}" FontWeight="SemiBold" Text="R$ 168,00" />
                    <TextBlock Margin="3,0,0,2" VerticalAlignment="Bottom" Foreground="{DynamicResource SecondaryTextBrush}" Text="/un · 20 dias" />
                  </StackPanel>
                  <WrapPanel Margin="0,8,0,0">
                    <controls:Chip Margin="0,0,4,0" Content="Menor preço" Tone="Success" />
                    <controls:Chip Content="Menor prazo" Tone="Warning" />
                  </WrapPanel>
                </StackPanel>
              </ToolTip>
            </Button.ToolTip>
          </Button>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
