<UserControl
  x:Class="Uzor.Gallery.Pages.ButtonsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Uzor.Wpf.Controls;assembly=Uzor.Wpf"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Uzor.Wpf.Icons;assembly=Uzor.Wpf"
  xmlns:uzor="clr-namespace:Uzor.Wpf;assembly=Uzor.Wpf">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <controls:PageHeader Title="Botões e escolhas" Subtitle="Os botões por papel, as escolhas, as abas, os chips de tom e as faixas de aviso." />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,16">
        <TextBlock Style="{StaticResource GallerySection}" Text="AÇÕES" />
        <Border Style="{StaticResource GalleryCard}">
          <WrapPanel>
            <Button Margin="0,0,8,8" Content="Action" Style="{StaticResource Action}" />
            <Button Margin="0,0,8,8" hc:IconElement.Geometry="{icons:Phosphor PlusBold}" Content="Action.Primary" Style="{StaticResource Action.Primary}" />
            <Button Margin="0,0,8,8" hc:IconElement.Geometry="{icons:Phosphor TrashBold}" Content="Action.Danger" Style="{StaticResource Action.Danger}" />
            <Button Margin="0,0,8,8" Content="Desligado" IsEnabled="False" Style="{StaticResource Action.Primary}" />
            <Button Margin="0,0,8,8" VerticalAlignment="Center" Content="Action.Small" Style="{StaticResource Action.Small}" />
            <Button Margin="0,0,8,8" VerticalAlignment="Center" Content="Action.Primary.Small" Style="{StaticResource Action.Primary.Small}" />
            <Button Margin="0,0,8,8" hc:IconElement.Geometry="{icons:Phosphor ArrowsClockwiseBold}" Style="{StaticResource Action.Icon}" ToolTip="Action.Icon" />
            <Button Margin="0,0,8,8" VerticalAlignment="Center" hc:IconElement.Geometry="{icons:Phosphor GearSixBold}" Style="{StaticResource Action.Icon.Small}" ToolTip="Action.Icon.Small" />
          </WrapPanel>
        </Border>

        <TextBlock Style="{StaticResource GallerySection}" Text="ESCOLHAS" />
        <Border Style="{StaticResource GalleryCard}">
          <StackPanel>
            <WrapPanel>
              <CheckBox Margin="0,0,24,12" Content="Desmarcada" />
              <CheckBox Margin="0,0,24,12" Content="Marcada" IsChecked="True" />
              <StackPanel Margin="0,0,24,12" Orientation="Horizontal">
                <ToggleButton Style="{StaticResource Switch}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Switch" />
              </StackPanel>
              <StackPanel Margin="0,0,24,12" Orientation="Horizontal">
                <ToggleButton IsChecked="True" Style="{StaticResource Switch}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Ligado" />
              </StackPanel>
            </WrapPanel>
            <WrapPanel>
              <Border Margin="0,0,16,0" Style="{StaticResource ChoiceGroup}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Content="Escuro" GroupName="Tema" IsChecked="True" Style="{StaticResource ChoiceRadio}" Tag="{icons:Phosphor MoonBold}" />
                  <RadioButton Content="Claro" GroupName="Tema" Style="{StaticResource ChoiceRadio}" Tag="{icons:Phosphor SunBold}" />
                </StackPanel>
              </Border>
              <Border Height="28" Style="{StaticResource SegmentedGroup}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Content="Todos" GroupName="Filtro" IsChecked="True" Style="{StaticResource SegmentedRadio}" />
                  <RadioButton Content="Abertos" GroupName="Filtro" Style="{StaticResource SegmentedRadio}" />
                  <RadioButton Content="Encerrados" GroupName="Filtro" Style="{StaticResource SegmentedRadio}" />
                </StackPanel>
              </Border>
            </WrapPanel>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource GallerySection}" Text="ABAS DE SEÇÃO" />
        <Border Style="{StaticResource GalleryCard}">
          <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="Abas" IsChecked="True" Style="{StaticResource SectionTab}" Tag="{icons:Phosphor ListBulletsBold}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Itens" />
                <Border Style="{StaticResource TabCount}">
                  <TextBlock Text="4" />
                </Border>
              </StackPanel>
            </RadioButton>
            <RadioButton GroupName="Abas" Style="{StaticResource SectionTab}" Tag="{icons:Phosphor FilesBold}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Arquivos" />
                <Border Style="{StaticResource TabCount}">
                  <TextBlock Text="12" />
                </Border>
              </StackPanel>
            </RadioButton>
            <RadioButton Content="Histórico" GroupName="Abas" Style="{StaticResource SectionTab}" Tag="{icons:Phosphor ClockCounterClockwiseBold}" />
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource GallerySection}" Text="CHIPS DE TOM" />
        <Border Style="{StaticResource GalleryCard}">
          <WrapPanel>
            <controls:Chip Margin="0,0,8,0" Content="Neutral" Tone="Neutral" />
            <controls:Chip Margin="0,0,8,0" Content="Accent" Tone="Accent" />
            <controls:Chip Margin="0,0,8,0" Content="Success" Tone="Success" />
            <controls:Chip Margin="0,0,8,0" Content="Warning" Tone="Warning" />
            <controls:Chip Margin="0,0,8,0" Content="Danger" Tone="Danger" />
            <controls:Chip Content="Info" Tone="Info" />
          </WrapPanel>
        </Border>

        <TextBlock Style="{StaticResource GallerySection}" Text="FAIXAS DE AVISO" />
        <Border Style="{StaticResource GalleryCard}">
          <StackPanel>
            <Border Margin="0,0,0,8" Style="{StaticResource InfoBanner}">
              <TextBlock Text="InfoBanner: um recado neutro, no azul suave." TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource WarningBanner}">
              <TextBlock Text="WarningBanner: algo pede atenção, no âmbar suave." TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
