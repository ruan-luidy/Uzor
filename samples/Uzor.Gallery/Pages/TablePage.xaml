<UserControl
  x:Class="Uzor.Gallery.Pages.TablePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Uzor.Wpf.Controls;assembly=Uzor.Wpf"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Uzor.Wpf.Icons;assembly=Uzor.Wpf"
  xmlns:behaviors="clr-namespace:Uzor.Wpf.Behaviors;assembly=Uzor.Wpf"
  xmlns:uzor="clr-namespace:Uzor.Wpf;assembly=Uzor.Wpf">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <controls:PageHeader Title="Tabela" Subtitle="StandardDataGrid com o filtro rápido (QuickFilter), números à direita e chips de tom. Botão direito copia ou exporta." />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,16">
        <Border Style="{StaticResource GalleryCard}">
          <DockPanel>
            <hc:TextBox
              x:Name="Filter"
              Margin="0,0,0,10"
              HorizontalAlignment="Left"
              DockPanel.Dock="Top"
              Style="{StaticResource FilterBox}" />
            <DataGrid
              x:Name="Table"
              Height="420"
              behaviors:QuickFilter.Text="{Binding Text, ElementName=Filter}"
              Style="{StaticResource EmbeddedDataGrid}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="100" Header="Código">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock FontFamily="{StaticResource FontFamily.Numbers}" FontWeight="SemiBold" Style="{StaticResource TextCell}" Text="{Binding Code}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="*" Header="Descrição">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource TextCell}" Text="{Binding Description}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="80" Header="Qtd" HeaderStyle="{StaticResource NumberColumnHeader}">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource NumberCell}" Text="{Binding Quantity}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="130" Header="Status">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <controls:Chip Content="{Binding Status.Text}" Tone="{Binding Status.Tone}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="120" Header="Prazo">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource TextCell}" Text="{Binding Deadline}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
