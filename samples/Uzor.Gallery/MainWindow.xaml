<hc:Window
  x:Class="Uzor.Gallery.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Uzor.Wpf.Controls;assembly=Uzor.Wpf"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Uzor.Wpf.Icons;assembly=Uzor.Wpf"
  xmlns:services="clr-namespace:Uzor.Wpf.Services;assembly=Uzor.Wpf"
  Title="Uzor"
  Width="1280"
  Height="800"
  MinWidth="960"
  MinHeight="600"
  hc:Dialog.Token="{x:Static services:DialogService.Token}"
  BorderBrush="{DynamicResource BorderBrush}"
  NonClientAreaBackground="Transparent"
  ShowTitle="True"
  WindowStartupLocation="CenterScreen">

  <!--  Na barra de título: o selo da vitrine e a troca de tema (em onda)  -->
  <hc:Window.NonClientAreaContent>
    <Grid>
      <Border Style="{StaticResource TitleBadge}">
        <TextBlock Text="VITRINE" />
      </Border>
      <Button
        Margin="0,0,10,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        hc:IconElement.Geometry="{icons:Phosphor SunBold}"
        Click="Theme_Click"
        Style="{StaticResource Action.Icon.Small}"
        ToolTip="Trocar entre claro e escuro" />
    </Grid>
  </hc:Window.NonClientAreaContent>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!--  O painel lateral direto no fundo da janela, como no Provodnik  -->
    <DockPanel Margin="8">
      <TextBlock
        Margin="12,4,0,12"
        DockPanel.Dock="Top"
        Style="{StaticResource CaptionText}"
        Text="Kit de interface dos apps" />
      <StackPanel x:Name="Nav" />
    </DockPanel>

    <Border
      Grid.Column="1"
      Background="{DynamicResource Pane.BackgroundBrush}"
      CornerRadius="12,0,0,0" />
    <controls:PageHost
      x:Name="Host"
      Grid.Column="1" />
  </Grid>
</hc:Window>
