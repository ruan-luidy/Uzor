<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:formatting="clr-namespace:Uzor.Wpf"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
  xmlns:icons="clr-namespace:Uzor.Wpf.Icons">

  <!--
    ========================================
    COMPONENTES DO WINDOWS COM A CARA DO TERMINAL
    ========================================
    O HandyControl dá o tema escuro, mas barra de rolagem, menu de contexto, tooltip, item de combo e calendário
    ainda saem com o jeitão padrão dele. Aqui eles ficam iguais ao resto: canto arredondado, realce na cor de
    destaque e nada de moldura grossa. São estilos implícitos: valem em toda a janela sem ninguém pedir.
  -->

  <!--  Barra de rolagem: fina, sem setas, o polegar aparecendo só onde há rolagem  -->
  <SolidColorBrush x:Key="ScrollBar.ThumbBrush" Color="#4A4A4A" />
  <SolidColorBrush x:Key="ScrollBar.ThumbHoverBrush" Color="#6F6F6F" />
  <SolidColorBrush x:Key="ScrollBar.ThumbPressedBrush" Color="#9A9A9A" />

  <Style x:Key="TerminalScrollThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border
            x:Name="Bar"
            Background="{DynamicResource ScrollBar.ThumbBrush}"
            CornerRadius="3"
            SnapsToDevicePixels="True" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollBar.ThumbHoverBrush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollBar.ThumbPressedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="9" />
    <Setter Property="MinWidth" Value="9" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Margin="2,0" Style="{StaticResource TerminalScrollThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton
                  Command="ScrollBar.PageDownCommand"
                  Opacity="0"
                  Style="{x:Null}" />
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton
                  Command="ScrollBar.PageUpCommand"
                  Opacity="0"
                  Style="{x:Null}" />
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="9" />
        <Setter Property="MinHeight" Value="9" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track">
                  <Track.Thumb>
                    <Thumb Margin="0,2" Style="{StaticResource TerminalScrollThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton
                      Command="ScrollBar.PageRightCommand"
                      Opacity="0"
                      Style="{x:Null}" />
                  </Track.IncreaseRepeatButton>
                  <Track.DecreaseRepeatButton>
                    <RepeatButton
                      Command="ScrollBar.PageLeftCommand"
                      Opacity="0"
                      Style="{x:Null}" />
                  </Track.DecreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    Menu de contexto no jeito do menu do Windows 11 (06/11/2026): cartão no cinza dos flutuantes (Flyout.BackgroundBrush)
    com a borda fraca e a sombra, itens de 30 com o realce arredondado, ícone de 16 numa coluna própria (alinhado mesmo
    em item sem ícone), atalho em cinza, seta de submenu e o separador fino no tom da divisória. O do HandyControl
    (ContextMenu.Small) tinha o separador numa linha branca forte e o realce sumindo no cinza do menu escuro. A chave
    ContextMenu.Small passa a ser este (o Negativo pede ela pelo nome em 61 menus) e o implícito também, então vale até
    pro menu de copiar/colar dos campos.
  -->
  <Style x:Key="Uzor.MenuSeparator" TargetType="Separator">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border
            Height="1"
            Margin="10,4"
            Background="{DynamicResource Divider.Brush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Uzor.MenuItem" TargetType="MenuItem">
    <Style.Resources>
      <!--
        O ícone do item é do menu, não da tela (06/11/2026, "a padronização desses símbolos"): o Phosphor em 14 na cor
        de destaque, todos iguais, como no Windfinder. A tela diz só QUAL ícone (Kind, sempre Bold) - cor ou tamanho
        escritos no ícone ganhariam deste estilo, e o PadraoDeIconeDoMenuTests barra.
      -->
      <Style TargetType="iconPacks:PackIconPhosphorIcons">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
      </Style>
    </Style.Resources>
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,0,8,0" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid SnapsToDevicePixels="True">
            <Border
              x:Name="Bg"
              Background="Transparent"
              CornerRadius="{StaticResource Radius.Md}" />
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
                <ColumnDefinition Width="14" />
              </Grid.ColumnDefinitions>
              <ContentPresenter
                x:Name="IconHost"
                Width="16"
                Height="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ContentSource="Icon" />
              <Path
                x:Name="CheckMark"
                Width="11"
                Height="11"
                VerticalAlignment="Center"
                Data="{icons:Phosphor CheckBold}"
                Fill="{DynamicResource PrimaryBrush}"
                Stretch="Uniform"
                Visibility="Collapsed" />
              <ContentPresenter
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                ContentSource="Header"
                RecognizesAccessKey="True" />
              <TextBlock
                Grid.Column="2"
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                FontSize="{StaticResource FontSize.Sm}"
                Foreground="{DynamicResource MutedTextBrush}"
                Text="{TemplateBinding InputGestureText}" />
              <Path
                x:Name="SubmenuArrow"
                Grid.Column="3"
                Width="8"
                Height="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Data="{icons:Phosphor CaretRightBold}"
                Fill="{DynamicResource SecondaryTextBrush}"
                Stretch="Uniform"
                Visibility="Collapsed" />
            </Grid>
            <!--
              O submenu: o mesmo cartão, 2 à direita do cartão do menu (o item termina 5 antes da borda dele: 4 de
              respiro + 1 de borda) e com o primeiro item na linha do item que abriu (-5 = respiro + borda do
              cartão do submenu). A folga da sombra é a margem do filho do Popup, que o WPF já desconta ao posicionar.
            -->
            <Popup
              x:Name="PART_Popup"
              AllowsTransparency="True"
              Focusable="False"
              HorizontalOffset="7"
              IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
              Placement="Right"
              PopupAnimation="Fade"
              VerticalOffset="-5">
              <Grid Margin="12,8,12,18">
                <Border
                  Background="{DynamicResource Flyout.BackgroundBrush}"
                  CornerRadius="{StaticResource Radius.Lg}"
                  Effect="{DynamicResource Shadow.Flyout}" />
                <Border
                  MinWidth="180"
                  Padding="4"
                  Background="{DynamicResource Flyout.BackgroundBrush}"
                  BorderBrush="{DynamicResource Flyout.BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Lg}">
                  <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
              <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True" />
                <Condition Property="Icon" Value="{x:Null}" />
              </MultiTrigger.Conditions>
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ContextMenu.Small" TargetType="ContextMenu">
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="FontFamily" Value="{StaticResource FontFamily.Default}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Grid.IsSharedSizeScope" Value="True" />
    <!--  Entra crescendo de 96% (aqui e não no implícito: o Negativo pede a chave pelo nome)  -->
    <Setter Property="RenderTransformOrigin" Value="0.5,0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform">
      <Setter.Value>
        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <!--  Folga pra sombra não cortar  -->
          <Grid Margin="12,8,12,18">
            <Border
              Background="{DynamicResource Flyout.BackgroundBrush}"
              CornerRadius="{StaticResource Radius.Lg}"
              Effect="{DynamicResource Shadow.Flyout}" />
            <Border
              Padding="4"
              Background="{DynamicResource Flyout.BackgroundBrush}"
              BorderBrush="{DynamicResource Flyout.BorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource Radius.Lg}">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Resources>
      <Style BasedOn="{StaticResource Uzor.MenuSeparator}" TargetType="Separator" />
      <Style
        x:Key="{x:Static MenuItem.SeparatorStyleKey}"
        BasedOn="{StaticResource Uzor.MenuSeparator}"
        TargetType="Separator" />
      <Style BasedOn="{StaticResource Uzor.MenuItem}" TargetType="MenuItem" />
    </Style.Resources>
    <Style.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation
              Storyboard.TargetProperty="RenderTransform.ScaleX"
              To="1"
              Duration="0:0:0.13">
              <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
              Storyboard.TargetProperty="RenderTransform.ScaleY"
              To="1"
              Duration="0:0:0.13">
              <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
              Storyboard.TargetProperty="Opacity"
              To="1"
              Duration="0:0:0.13" />
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Style.Triggers>
  </Style>

  <!--  Todo ContextMenu sem estilo (o de copiar/colar dos campos) é o mesmo  -->
  <Style BasedOn="{StaticResource ContextMenu.Small}" TargetType="ContextMenu" />

  <!--
    Menu do ícone do relógio (o do Otmetka): cartão com sombra, ícone à esquerda, atalho em cinza à direita e
    quem entrou no topo. Os itens e o separador mudam só aqui dentro; os menus de botão direito seguem o de cima
  -->
  <Style x:Key="TrayMenu" TargetType="ContextMenu">
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="MinWidth" Value="210" />
    <Setter Property="FontFamily" Value="{StaticResource FontFamily.Default}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Grid.IsSharedSizeScope" Value="True" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform">
      <Setter.Value>
        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <!--  Folga pra sombra não cortar  -->
          <Grid Margin="12,8,12,18">
            <Border
              Background="{DynamicResource RegionBrush}"
              CornerRadius="{StaticResource Radius.Lg}"
              Effect="{DynamicResource Shadow.Flyout}" />
            <Border
              Padding="4"
              Background="{DynamicResource RegionBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource Radius.Lg}">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Resources>
      <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Separator">
              <Border
                Height="1"
                Margin="8,4"
                Background="{DynamicResource BorderBrush}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="MenuItem">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
              <Grid SnapsToDevicePixels="True">
                <Border
                  x:Name="Bg"
                  Background="Transparent"
                  CornerRadius="{StaticResource Radius.Md}" />
                <Grid Margin="{TemplateBinding Padding}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter
                    Width="14"
                    Height="14"
                    VerticalAlignment="Center"
                    ContentSource="Icon" />
                  <ContentPresenter
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    ContentSource="Header"
                    RecognizesAccessKey="True" />
                  <TextBlock
                    Grid.Column="2"
                    Margin="24,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSize.Sm}"
                    Foreground="{DynamicResource ThirdlyTextBrush}"
                    Text="{TemplateBinding InputGestureText}" />
                </Grid>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Style.Resources>
    <Style.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation
              Storyboard.TargetProperty="RenderTransform.ScaleX"
              To="1"
              Duration="0:0:0.13">
              <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
              Storyboard.TargetProperty="RenderTransform.ScaleY"
              To="1"
              Duration="0:0:0.13">
              <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
              Storyboard.TargetProperty="Opacity"
              To="1"
              Duration="0:0:0.13" />
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Style.Triggers>
  </Style>

  <!--  Cabeçalho do menu do relógio (quem entrou): só texto, não clica  -->
  <ControlTemplate x:Key="MenuTitleTemplate" TargetType="MenuItem">
    <ContentPresenter Margin="10,6,10,6" ContentSource="Header" />
  </ControlTemplate>

  <!--  O tooltip mora no Kit.xaml: usa o cartão e a sombra dos menus, que vêm do Shell.xaml  -->

  <!--  Item de lista suspensa (combo): o item do menu da conta, como o SelectField  -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="5,1" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border
            x:Name="Row"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            CornerRadius="{StaticResource Radius.Md}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ========================================
    CALENDÁRIO
    ========================================
    Usado pelo campo de data (Controls/DateField). Dia é um quadradinho de 30 px que arredonda no mouse, hoje ganha
    borda na cor de destaque e o escolhido fica preenchido. Cabeçalho com o mês e as setas do lado.
  -->
  <Style x:Key="CalendarNavButton" TargetType="Button">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Bd"
            Background="Transparent"
            CornerRadius="{StaticResource Radius.Sm}">
            <Path
              x:Name="Arrow"
              Width="9"
              Height="9"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Data="{TemplateBinding Content}"
              Fill="{TemplateBinding Foreground}"
              Stretch="Uniform" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
              <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TerminalCalendarDayButton" TargetType="CalendarDayButton">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarDayButton">
          <Border
            x:Name="Bd"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Sm}">
            <ContentPresenter
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              TextBlock.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
            </Trigger>
            <Trigger Property="IsToday" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
              <Setter Property="Foreground" Value="White" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsInactive" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}" />
            </Trigger>
            <Trigger Property="IsBlackedOut" Value="True">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  Mês e ano (o calendário mostra quando se clica no cabeçalho)  -->
  <Style x:Key="TerminalCalendarButton" TargetType="CalendarButton">
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarButton">
          <Border
            x:Name="Bd"
            Background="Transparent"
            CornerRadius="{StaticResource Radius.Sm}">
            <ContentPresenter
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              TextBlock.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
            </Trigger>
            <Trigger Property="HasSelectedDays" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Selection.RowBrush}" />
            </Trigger>
            <Trigger Property="IsInactive" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TerminalCalendarItem" TargetType="CalendarItem">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarItem">
          <Grid x:Name="PART_Root">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="2,0,2,4">
              <Button
                x:Name="PART_PreviousButton"
                Content="{icons:Phosphor CaretLeftBold}"
                DockPanel.Dock="Left"
                Style="{StaticResource CalendarNavButton}" />
              <Button
                x:Name="PART_NextButton"
                Content="{icons:Phosphor CaretRightBold}"
                DockPanel.Dock="Right"
                Style="{StaticResource CalendarNavButton}" />
              <Button
                x:Name="PART_HeaderButton"
                Cursor="Hand"
                FontSize="{StaticResource FontSize.Sm}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource PrimaryTextBrush}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border
                      x:Name="Bd"
                      Padding="8,4"
                      Background="Transparent"
                      CornerRadius="{StaticResource Radius.Sm}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </DockPanel>

            <!--  Iniciais dos dias, alinhadas com as colunas de 30 px  -->
            <ItemsControl
              Grid.Row="1"
              ItemsSource="{Binding Source={x:Static formatting:WeekDays.Initials}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock
                    Width="30"
                    Margin="1,0,1,3"
                    FontSize="{StaticResource FontSize.XS}"
                    Foreground="{DynamicResource ThirdlyTextBrush}"
                    Text="{Binding}"
                    TextAlignment="Center" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid x:Name="PART_MonthView" Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
            </Grid>

            <Grid
              x:Name="PART_YearView"
              Grid.Row="2"
              Visibility="Hidden">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year">
              <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade">
              <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TerminalCalendar" TargetType="Calendar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CalendarDayButtonStyle" Value="{StaticResource TerminalCalendarDayButton}" />
    <Setter Property="CalendarButtonStyle" Value="{StaticResource TerminalCalendarButton}" />
    <Setter Property="CalendarItemStyle" Value="{StaticResource TerminalCalendarItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Calendar">
          <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
            <CalendarItem
              x:Name="PART_CalendarItem"
              Background="{TemplateBinding Background}"
              Style="{TemplateBinding CalendarItemStyle}" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!--
    ═══ Flutuantes e listas suspensas (06/11/2026, "esse dropdown não tá no padrão, acho que vários não estão") ═══
    Um jeito só pra tudo que abre por cima da tela: o CARTÃO dos flutuantes (o do menu de contexto: cinza dos menus,
    borda fraca, raio 8, a Shadow.Flyout numa borda atrás) e o CAMPO que abre ele (fundo translúcido dos botões, sem
    borda, mais claro no mouse e aberto, a seta que vira pra cima). O combo (Uzor.Combo) e o botão de abrir popup
    (ToggleButtonDropdown) são o mesmo campo; a lista do combo e os popups das telas são o mesmo cartão.

    A folga da sombra é a MARGEM do filho do Popup, e o WPF já desconta a margem do filho ao posicionar (alinha a caixa
    dele, sem a margem, com o alvo): o Popup fica com 0 na horizontal e o respiro de 4 na vertical, nunca -12.

      <Popup AllowsTransparency="True" Placement="Bottom" StaysOpen="False" VerticalOffset="4" ...>
        <ContentControl Style="{StaticResource Uzor.Flyout}">...</ContentControl>
      </Popup>
  -->
  <Thickness x:Key="Flyout.ShadowRoom">12,8,12,18</Thickness>

  <Style x:Key="Uzor.Flyout" TargetType="ContentControl">
    <Setter Property="Margin" Value="{StaticResource Flyout.ShadowRoom}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <!--  A sombra num cartão só dela atrás: no cartão do conteúdo o efeito borraria o texto  -->
            <Border
              Background="{DynamicResource Flyout.BackgroundBrush}"
              CornerRadius="{StaticResource Radius.Lg}"
              Effect="{DynamicResource Shadow.Flyout}" />
            <Border
              Padding="{TemplateBinding Padding}"
              Background="{DynamicResource Flyout.BackgroundBrush}"
              BorderBrush="{DynamicResource Flyout.BorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource Radius.Lg}">
              <ContentPresenter />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Linha clicável dentro de um flutuante (as opções de um seletor feito à mão): 30 de altura, o realce arredondado do
    menu no mouse. Serve em Button, ToggleButton e RadioButton.
  -->
  <Style x:Key="Uzor.FlyoutItem" TargetType="ButtonBase">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border
            x:Name="Row"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            CornerRadius="{StaticResource Radius.Md}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  Item da lista do combo: 30 de altura, realce arredondado no mouse/teclado e o escolhido marcado  -->
  <Style x:Key="Uzor.ComboItem" TargetType="ComboBoxItem">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border
            x:Name="Row"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            CornerRadius="{StaticResource Radius.Md}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <!--  O escolhido vem depois: com o mouse em cima ele continua marcado  -->
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Nav.SelectedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  O mesmo item numa ListBox dentro de um flutuante (as listas de escolha feitas com ListBox)  -->
  <Style x:Key="Uzor.ListItem" TargetType="ListBoxItem">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border
            x:Name="Row"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            CornerRadius="{StaticResource Radius.Md}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Nav.SelectedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    O combo: o campo (fundo translúcido dos botões, sem borda, raio 4, 28 de altura como os campos de texto) e a lista
    no cartão dos flutuantes, colada embaixo dele. Mostra o hc:InfoElement.Placeholder sem nada escolhido e o
    hc:TitleElement.Title em cima, como os campos com título.
  -->
  <Style x:Key="Uzor.Combo" TargetType="ComboBox">
    <Setter Property="MinHeight" Value="{StaticResource Control.Height}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{DynamicResource Button.BackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="MaxDropDownHeight" Value="360" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Uzor.ComboItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
              x:Name="Title"
              Margin="0,0,0,6"
              Foreground="{DynamicResource PrimaryTextBrush}"
              Text="{TemplateBinding hc:TitleElement.Title}" />

            <Grid
              x:Name="Root"
              Grid.Row="1"
              MinHeight="{TemplateBinding MinHeight}">
              <Border
                x:Name="Field"
                Background="{TemplateBinding Background}"
                CornerRadius="{StaticResource Radius.Sm}" />

              <!--
                O campo todo abre a lista; o texto e a seta por cima não pegam o clique. Sem estilo nenhum de fora: o
                ToggleButton implícito do HandyControl não estica e ficava com 0 de largura.
              -->
              <ToggleButton
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ClickMode="Press"
                Focusable="False"
                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                OverridesDefaultStyle="True"
                Style="{x:Null}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  Content="{TemplateBinding SelectionBoxItem}"
                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                <TextBlock
                  x:Name="Placeholder"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource MutedTextBrush}"
                  Text="{TemplateBinding hc:InfoElement.Placeholder}"
                  TextTrimming="CharacterEllipsis"
                  Visibility="Collapsed" />
                <iconPacks:PackIconPhosphorIcons
                  x:Name="Chevron"
                  Grid.Column="1"
                  Width="10"
                  Height="10"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource SecondaryTextBrush}"
                  Kind="CaretDownBold"
                  RenderTransformOrigin="0.5,0.5" />
              </Grid>

              <Popup
                x:Name="PART_Popup"
                AllowsTransparency="True"
                Focusable="False"
                IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=Root}"
                PopupAnimation="Fade"
                VerticalOffset="4">
                <ContentControl
                  x:Name="DropDownCard"
                  MinWidth="{Binding ActualWidth, ElementName=Root}"
                  Padding="4,3"
                  Style="{StaticResource Uzor.Flyout}">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" Focusable="False">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </ContentControl>
              </Popup>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="hc:TitleElement.Title" Value="{x:Null}">
              <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="hc:TitleElement.Title" Value="">
              <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="SelectedItem" Value="{x:Null}">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Field" Property="Background" Value="{DynamicResource Button.HoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Field" Property="Background" Value="{DynamicResource Button.HoverBrush}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Field" Property="Background" Value="{DynamicResource Button.HoverBrush}" />
              <Setter TargetName="Chevron" Property="RenderTransform">
                <Setter.Value>
                  <RotateTransform Angle="180" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="DropDownCard" Property="MinHeight" Value="32" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
