<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Uzor.Wpf.Controls"
  xmlns:converters="clr-namespace:Uzor.Wpf.Converters"
  xmlns:anim="clr-namespace:Uzor.Wpf.Animation"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Uzor.Wpf.Icons"
  xmlns:system="clr-namespace:System;assembly=mscorlib">

  <!--
    O kit da Uzor (o que nasceu no Handoff em cima do Provodnik): conversores, painel lateral, tabelas embutidas, chips
    de tom, abas de seção, caixa de mensagem, lista selecionável, grupo da tabela agrupada, faixas de aviso, campos, o
    tooltip, a escolha de opções e os seletores do HandyControl no fundo translúcido.
  -->

  <converters:EnumToBooleanConverter x:Key="Is" />
  <converters:CountToVisibilityConverter x:Key="WhenAny" />
  <converters:CountToVisibilityConverter x:Key="WhenEmpty" Inverted="True" />
  <converters:KeepSpaceConverter x:Key="KeepSpace" />
  <converters:EnumToVisibilityConverter x:Key="WhenIs" />

  <!--  O número do cartão: o "—" do placeholder fica a meia luz, no mesmo tamanho do número que vai chegar  -->
  <Style x:Key="StatCardValue" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Display}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <!--
    Item do painel lateral (o NavigationView da Microsoft, modo Left): ícone no Tag (Geometry), o texto e o contador
    (NavBadge). O aberto ganha o fundo cinza e a barrinha azul à esquerda. Recolhido (PaneCompact do shell) fica só o
    ícone, o contador vira bolinha e o nome vai pro tooltip. SideNavButton é o mesmo visual num botão (rodapé).
  -->
  <ControlTemplate x:Key="SideNavTemplate" TargetType="ButtonBase">
    <Grid>
      <Border
        x:Name="Item"
        Height="{StaticResource Nav.ItemHeight}"
        Padding="10,0"
        Background="Transparent"
        CornerRadius="{StaticResource Radius.Md}">
        <Grid x:Name="Row">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Path
            x:Name="Icon"
            Width="{StaticResource Icon.Size.Nav}"
            Height="{StaticResource Icon.Size.Nav}"
            Data="{TemplateBinding Tag}"
            Fill="{TemplateBinding Foreground}"
            Stretch="Uniform" />
          <ContentPresenter
            x:Name="Label"
            Grid.Column="1"
            Margin="12,0,0,0"
            VerticalAlignment="Center" />
          <Border
            x:Name="Badge"
            Grid.Column="2"
            Height="18"
            MinWidth="18"
            Margin="8,0,0,0"
            Padding="5,0"
            Background="{DynamicResource PrimaryBrush}"
            CornerRadius="9">
            <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="{StaticResource FontSize.XS}"
              Foreground="White"
              Text="{Binding (controls:NavBadge.Count), RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
          <Ellipse
            x:Name="Dot"
            Width="7"
            Height="7"
            Margin="0,5,-3,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Fill="{Binding Background, ElementName=Badge}"
            Visibility="Collapsed" />
        </Grid>
      </Border>
      <Border
        x:Name="Bar"
        Width="3"
        Height="16"
        HorizontalAlignment="Left"
        Background="{DynamicResource PrimaryBrush}"
        CornerRadius="2"
        Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      </Trigger>
      <Trigger Property="controls:NavBadge.IsAlert" Value="True">
        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DangerBrush}" />
      </Trigger>
      <DataTrigger Binding="{Binding DataContext.PaneCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
        <Setter TargetName="Item" Property="Padding" Value="0" />
        <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center" />
        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <Trigger Property="controls:NavBadge.Count" Value="0">
        <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="ToggleButton.IsChecked" Value="True">
        <Setter TargetName="Item" Property="Background" Value="{DynamicResource Nav.SelectedBrush}" />
        <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
        <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!--  Etiqueta na barra de título (DEMO): amarela, texto preto, encostada no nome do app  -->
  <Style x:Key="TitleBadge" TargetType="Border">
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="TextElement.FontSize" Value="{StaticResource FontSize.XS}" />
    <Setter Property="TextElement.FontWeight" Value="Bold" />
    <Setter Property="TextElement.Foreground" Value="Black" />
  </Style>

  <!--  O disco das iniciais de quem entrou (botão do usuário e cabeçalho do menu)  -->
  <Style x:Key="AvatarDisc" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="TextElement.Foreground" Value="White" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
  </Style>

  <!--
    ========================================
    TABELAS
    ========================================
    O StandardDataGrid do Provodnik já é um cartão. Dentro de um cartão com outras coisas (o editor, os diálogos), a
    tabela vai sem fundo próprio pra não virar cartão dentro de cartão. O cabeçalho de número segue o cabeçalho
    padrão do Provodnik, só que à direita (o do DesignSystem ainda é o do Terminal).
  -->
  <Style
    x:Key="EmbeddedDataGrid"
    BasedOn="{StaticResource StandardDataGrid}"
    TargetType="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style
    x:Key="NumberColumnHeader"
    BasedOn="{StaticResource StandardColumnHeader}"
    TargetType="DataGridColumnHeader">
    <Setter Property="HorizontalContentAlignment" Value="Right" />
  </Style>

  <!--
    ========================================
    CHIP DE STATUS
    ========================================
    Fundo da cor do tom a ~18% e o texto na cor cheia (o Success e o Accent vêm do Shell.xaml). O texto tem um tom por
    tema (o ThemeService troca): o amarelo e o ciano cheios somem no fundo branco.
  -->
  <SolidColorBrush
    x:Key="Info.SoftBrush"
    Opacity="0.16"
    Color="#00BCD4" />
  <SolidColorBrush
    x:Key="Neutral.SoftBrush"
    Opacity="0.2"
    Color="#8A8A90" />

  <SolidColorBrush x:Key="Success.TextBrush" Color="#3DCB5E" />
  <SolidColorBrush x:Key="Accent.TextBrush" Color="#6FA3DC" />
  <SolidColorBrush x:Key="Info.TextBrush" Color="#3BC9DB" />
  <SolidColorBrush x:Key="Warning.TextBrush" Color="#E9AF20" />
  <SolidColorBrush x:Key="Danger.TextBrush" Color="#E5525E" />
  <!--  O cinza apagado do texto de apoio (rótulo de cartão, legenda): o ThemeService troca por tema  -->
  <SolidColorBrush x:Key="MutedTextBrush" Color="#85858C" />
  <!--  O laranja do Negativo (atraso, hora extra): no claro, um tom mais fechado pra não sumir no branco  -->
  <SolidColorBrush x:Key="Orange.TextBrush" Color="#FF8A5C" />

  <Style TargetType="controls:Chip">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Background" Value="{DynamicResource Nav.SelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <!--  A pílula do Provodnik (TonePill): cápsula de 20, texto normal no meio. Na tabela ocupa a coluna (Stretch)  -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:Chip">
          <Border
            Height="20"
            Padding="9,0"
            Background="{TemplateBinding Background}"
            CornerRadius="10">
            <ContentPresenter
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tone" Value="Accent">
        <Setter Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.TextBrush}" />
      </Trigger>
      <Trigger Property="Tone" Value="Success">
        <Setter Property="Background" Value="{DynamicResource Success.SoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Success.TextBrush}" />
      </Trigger>
      <Trigger Property="Tone" Value="Warning">
        <Setter Property="Background" Value="{DynamicResource Warning.SoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Warning.TextBrush}" />
      </Trigger>
      <Trigger Property="Tone" Value="Danger">
        <Setter Property="Background" Value="{DynamicResource Danger.SoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Danger.TextBrush}" />
      </Trigger>
      <Trigger Property="Tone" Value="Info">
        <Setter Property="Background" Value="{DynamicResource Info.SoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Info.TextBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    ========================================
    ABAS (NavTab do Terminal)
    ========================================
    30 de altura, 12 SemiBold, a aberta com o sublinhado de 2 px no destaque. Grupo de RadioButton numa StackPanel.
  -->
  <Style x:Key="NavTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="anim:Motion.PressFeedback" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Height="30" Background="Transparent">
            <ContentPresenter
              Margin="12,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
            <Border
              x:Name="Underline"
              Height="2"
              VerticalAlignment="Bottom"
              Background="{DynamicResource PrimaryBrush}"
              CornerRadius="1"
              Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
              <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Abas de seção (as partes de uma tela de detalhe): pílula com ícone, nome e o número num selinho. A aberta ganha o fundo de
    seleção do Provodnik, como o item ativo do painel lateral; sem linha embaixo. O ícone vem no Tag.
  -->
  <Style x:Key="SectionTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="anim:Motion.PressFeedback" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border
            x:Name="Pill"
            Height="32"
            Padding="11,0"
            Background="Transparent"
            CornerRadius="{StaticResource Radius.Md}">
            <StackPanel Orientation="Horizontal">
              <Path
                x:Name="Icon"
                Width="14"
                Height="14"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Data="{TemplateBinding Tag}"
                Fill="{TemplateBinding Foreground}"
                Stretch="Uniform" />
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Nav.SelectedBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Caixa de composição (responder dúvida): um cartão só com o texto em cima e a barra de ações embaixo, como nos
    apps de conversa. Mais claro com o foco em qualquer coisa dentro dele.
  -->
  <Style x:Key="Composer" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Button.BackgroundBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="Background" Value="{DynamicResource Button.HoverBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--  O texto dentro do Composer: sem fundo nem borda, várias linhas, o texto de exemplo fica até digitar  -->
  <Style x:Key="ComposerText" TargetType="hc:TextBox">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,10,12,4" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="hc:TextBox">
          <Grid Background="Transparent">
            <TextBlock
              x:Name="Placeholder"
              Margin="{TemplateBinding Padding}"
              Padding="2,0"
              Foreground="{DynamicResource SecondaryTextBrush}"
              IsHitTestVisible="False"
              Text="{TemplateBinding hc:InfoElement.Placeholder}"
              TextWrapping="Wrap"
              Visibility="Collapsed" />
            <ScrollViewer
              x:Name="PART_ContentHost"
              Margin="{TemplateBinding Padding}"
              Focusable="False"
              HorizontalScrollBarVisibility="Hidden"
              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  O número da aba: selinho redondo, neutro; âmbar quando pede atenção (dúvida sem resposta)  -->
  <Style x:Key="TabCount" TargetType="Border">
    <Setter Property="Height" Value="18" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="{DynamicResource Button.HoverBrush}" />
    <Setter Property="TextElement.FontSize" Value="11" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </Style.Resources>
  </Style>

  <!--  A linha embaixo das abas, de ponta a ponta  -->
  <Style x:Key="NavTabStrip" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <!--
    ========================================
    LISTA SELECIONÁVEL (lista + detalhe)
    ========================================
    ListBox sem moldura dentro de um SurfaceCard; a linha tem raio 6, hover cinza e a selecionada ganha o fundo da
    página com a barrinha azul (o item ativo do painel lateral).
  -->
  <Style x:Key="PlainListBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="Margin" Value="0,0,0,2" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Grid>
                  <Border
                    x:Name="Row"
                    Padding="12,8"
                    Background="Transparent"
                    CornerRadius="{StaticResource Radius.Md}">
                    <ContentPresenter />
                  </Border>
                  <Border
                    x:Name="Bar"
                    Width="3"
                    Height="16"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource PrimaryBrush}"
                    CornerRadius="2"
                    Visibility="Collapsed" />
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Nav.SelectedBrush}" />
                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ========================================
    GRUPO EXPANSÍVEL (o cabeçalho de grupo da tabela agrupada)
    ========================================
  -->
  <Style x:Key="GroupExpander" TargetType="Expander">
    <Setter Property="IsExpanded" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel>
            <ToggleButton
              Height="NaN"
              Padding="0"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              anim:Motion.PressFeedback="False"
              Background="Transparent"
              BorderThickness="0"
              Cursor="Hand"
              DockPanel.Dock="Top"
              FocusVisualStyle="{x:Null}"
              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border
                    x:Name="Head"
                    Margin="0,6,0,0"
                    Padding="6,5,6,7"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Grid.DividerBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="{StaticResource Radius.Sm}">
                    <DockPanel>
                      <Path
                        x:Name="Caret"
                        Width="10"
                        Height="10"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Data="{icons:Phosphor CaretRightBold}"
                        Fill="{DynamicResource SecondaryTextBrush}"
                        RenderTransformOrigin="0.5,0.5"
                        Stretch="Uniform">
                        <Path.RenderTransform>
                          <RotateTransform Angle="0" />
                        </Path.RenderTransform>
                      </Path>
                      <ContentPresenter VerticalAlignment="Center" />
                    </DockPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Head" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Caret" Property="RenderTransform">
                        <Setter.Value>
                          <RotateTransform Angle="90" />
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <ContentPresenter Content="{TemplateBinding Header}" />
            </ToggleButton>
            <ContentPresenter x:Name="Body" Visibility="Collapsed" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ========================================
    DETALHE (pares rótulo / valor)
    ========================================
  -->
  <Style x:Key="DetailLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>

  <Style x:Key="DetailValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!--  Título de bloco dentro do cartão (rótulo 10 em caixa alta)  -->
  <Style
    x:Key="BlockTitle"
    BasedOn="{StaticResource StatLabel}"
    TargetType="TextBlock">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!--  Rótulo de campo em formulário de página (em cima do campo)  -->
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>

  <!--  Faixa de aviso (âmbar suave): divergência, dica de estado  -->
  <Style x:Key="WarningBanner" TargetType="Border">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{DynamicResource Warning.SoftBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <Style x:Key="InfoBanner" TargetType="Border">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <!--  Ícone pequeno na frente de um texto (14 px)  -->
  <Style x:Key="InlineIcon" TargetType="Path">
    <Setter Property="Width" Value="{StaticResource Icon.Size}" />
    <Setter Property="Height" Value="{StaticResource Icon.Size}" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <!--  Campo de busca da barra de comandos (largo, com a lupa)  -->
  <Style
    x:Key="SearchBox"
    BasedOn="{StaticResource FilterBox}"
    TargetType="hc:TextBox">
    <!--  A busca do Provodnik (lupa, texto de exemplo, limpar); aqui ela vai pro servidor, não filtra a tabela  -->
    <Setter Property="Width" Value="260" />
    <Setter Property="ToolTip" Value="{x:Null}" />
  </Style>

  <!--
    Campo de texto: o FieldBox do Provodnik (fundo translúcido, sem borda). Por chave, não implícito: o HandyControl usa
    hc:TextBox por dentro do seletor de data e o implícito trocava o miolo dele (sumiam o ícone e o texto de exemplo).
    O de várias linhas (resposta, motivo) não pode ficar preso nos 28 do campo de uma linha.
  -->
  <Style
    x:Key="Field"
    BasedOn="{StaticResource FieldBox}"
    TargetType="hc:TextBox">
    <Style.Triggers>
      <Trigger Property="AcceptsReturn" Value="True">
        <Setter Property="Height" Value="NaN" />
        <Setter Property="MinHeight" Value="{StaticResource Control.Height}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    Tooltip no jeito do Windows 11: o cartão cinza dos menus (o do SelectField e do calendário) com a borda de luz
    fraca e a sombra curta numa borda atrás (no próprio cartão o Effect tiraria o ClearType), entrando num fade
    rápido. O texto quebra a linha em vez de sair numa tira comprida; com mais de uma linha, a primeira vira título
    (TipText). Conteúdo que não é texto (a célula da comparação) vem com o próprio modelo.
  -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Padding" Value="10,6,10,7" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Grid Margin="8,4,8,10">
            <Border
              Background="{DynamicResource Flyout.BackgroundBrush}"
              CornerRadius="{StaticResource Radius.Md}"
              Effect="{StaticResource Shadow.Popup}" />
            <Border
              MaxWidth="340"
              Padding="{TemplateBinding Padding}"
              Background="{DynamicResource Flyout.BackgroundBrush}"
              BorderBrush="{DynamicResource Flyout.BorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource Radius.Md}">
              <ContentPresenter>
                <ContentPresenter.Resources>
                  <DataTemplate DataType="{x:Type system:String}">
                    <controls:TipText Source="{Binding}" />
                  </DataTemplate>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsOpen" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.12" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    Escolha entre poucas opções num formulário (o tema): trilho translúcido da altura do campo, a opção marcada no
    azul cheio, como o segmentado do Provodnik. O ícone de cada opção vem no Tag.
  -->
  <Style x:Key="ChoiceGroup" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource Control.Height}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Button.BackgroundBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
  </Style>

  <Style x:Key="ChoiceRadio" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinWidth" Value="72" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border
            x:Name="Segment"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            CornerRadius="{StaticResource Radius.Sm}">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
              <Path
                x:Name="Icon"
                Width="12"
                Height="12"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                Data="{TemplateBinding Tag}"
                Fill="{TemplateBinding Foreground}"
                Stretch="Uniform" />
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Segment" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Segment" Property="Background" Value="{DynamicResource PrimaryBrush}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  Data, data e hora, senha e a lista do formulário genérico: o mesmo fundo dos campos, sem borda  -->
  <!--
    Seletor de data no fundo translúcido dos campos. O HandyControl pinta o texto de exemplo com o ThirdlyTextBrush e o
    ícone com o BorderBrush (os dois #3F3F46), que somem nesse fundo: aqui dentro viram o cinza apagado, como o texto de
    exemplo do FieldBox do Provodnik, e a borda sai pela espessura.
  -->
  <Style BasedOn="{StaticResource {x:Type hc:DatePicker}}" TargetType="hc:DatePicker">
    <Style.Resources>
      <SolidColorBrush x:Key="RegionBrush" Color="#2E808080" />
      <SolidColorBrush x:Key="ThirdlyTextBrush" Color="#85858C" />
      <SolidColorBrush x:Key="BorderBrush" Color="#85858C" />
    </Style.Resources>
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!--
    Senha do HandyControl no jeito do FieldBox: mesmo fundo, mais claro no mouse e no foco, e o texto de exemplo e o
    olho no cinza apagado (o #3F3F46 do HandyControl some no fundo translúcido)
  -->
  <Style BasedOn="{StaticResource {x:Type hc:PasswordBox}}" TargetType="hc:PasswordBox">
    <Style.Resources>
      <SolidColorBrush x:Key="ThirdlyTextBrush" Color="#85858C" />
      <SolidColorBrush x:Key="BorderBrush" Color="#85858C" />
    </Style.Resources>
    <!--  O cursor do HandyControl vinha preto, sumindo no fundo escuro  -->
    <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource Button.BackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Button.HoverBrush}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="Background" Value="{DynamicResource Button.HoverBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style BasedOn="{StaticResource {x:Type PasswordBox}}" TargetType="PasswordBox">
    <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource Button.BackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

</ResourceDictionary>
