<UserControl
  x:Class="Uzor.Wpf.Controls.Toast"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="clr-namespace:Uzor.Wpf.Icons"
  xmlns:local="clr-namespace:Uzor.Wpf.Controls"
  HorizontalAlignment="Center"
  VerticalAlignment="Top">

  <UserControl.Resources>
    <!--  Entra descendo com um leve "quique" e sai subindo (o UpdateToast do rnzNegativeObserver)  -->
    <Storyboard x:Key="SlideIn">
      <DoubleAnimation
        Storyboard.TargetName="Card"
        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
        From="-60"
        To="0"
        Duration="0:0:0.35">
        <DoubleAnimation.EasingFunction>
          <BackEase Amplitude="0.3" EasingMode="EaseOut" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation
        Storyboard.TargetName="Card"
        Storyboard.TargetProperty="Opacity"
        From="0"
        To="1"
        Duration="0:0:0.25" />
    </Storyboard>

    <Storyboard x:Key="SlideOut">
      <DoubleAnimation
        Storyboard.TargetName="Card"
        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
        From="0"
        To="-60"
        Duration="0:0:0.2">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseIn" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation
        Storyboard.TargetName="Card"
        Storyboard.TargetProperty="Opacity"
        From="1"
        To="0"
        Duration="0:0:0.2" />
    </Storyboard>

    <!--
      Troca de conteúdo no MESMO cartão ("processando" virando "pronto"): o texto acende de leve em vez de o cartão
      sair e entrar de novo
    -->
    <Storyboard x:Key="Swap">
      <DoubleAnimation
        Storyboard.TargetName="Body"
        Storyboard.TargetProperty="Opacity"
        From="0.35"
        To="1"
        Duration="0:0:0.22">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseOut" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>

    <!--  O X: transparente, acende no hover como os botões sem borda do Uzor  -->
    <Style x:Key="ToastCloseButton" TargetType="Button">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bg"
              Background="Transparent"
              CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Button.HoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Button.PressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!--
    Largura fixa (era 380 a 480 conforme o texto): empilhados, cartões de larguras diferentes pareciam desalinhados.
    A superfície é a do menu do Windows 11 (Flyout.BackgroundBrush, um degrau acima da janela) com a borda fraca dele,
    e não a borda dura do HandyControl.
  -->
  <Grid
    x:Name="Card"
    Width="420"
    Margin="0,8,0,0"
    Opacity="0"
    RenderTransformOrigin="0.5,0"
    UseLayoutRounding="True">
    <Grid.RenderTransform>
      <TranslateTransform Y="-60" />
    </Grid.RenderTransform>
    <!--
      A sombra num cartão só dela, atrás: com o efeito no cartão do texto, o WPF desenha tudo como imagem e o texto
      borra
    -->
    <Border Background="{DynamicResource Flyout.BackgroundBrush}" CornerRadius="{StaticResource Radius.XL}">
      <Border.Effect>
        <DropShadowEffect
          BlurRadius="24"
          Direction="270"
          Opacity="0.28"
          ShadowDepth="6"
          Color="Black" />
      </Border.Effect>
    </Border>
    <Border
      x:Name="Surface"
      Background="{DynamicResource Flyout.BackgroundBrush}"
      BorderBrush="{DynamicResource Flyout.BorderBrush}"
      BorderThickness="1"
      CornerRadius="{StaticResource Radius.XL}">

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,10,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!--  O ícone num círculo da cor do tom bem apagada, com o ícone na cor cheia (o chip de status do Uzor)  -->
          <Border
            x:Name="IconDisc"
            Width="34"
            Height="34"
            Margin="0,0,12,0"
            VerticalAlignment="Top"
            Background="{DynamicResource Accent.SoftBrush}"
            CornerRadius="17">
            <Grid>
              <Path
                x:Name="IconPath"
                Width="18"
                Height="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="{DynamicResource Accent.TextBrush}"
                Stretch="Uniform" />
              <local:LoadingDots
                x:Name="BusyDots"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource Accent.TextBrush}"
                Visibility="Collapsed" />
            </Grid>
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock
              x:Name="TitleText"
              FontSize="{StaticResource FontSize.Body}"
              FontWeight="SemiBold"
              Foreground="{DynamicResource PrimaryTextBrush}"
              TextTrimming="CharacterEllipsis" />
            <TextBlock
              x:Name="MessageText"
              Margin="0,2,0,0"
              FontSize="{StaticResource FontSize.Sm}"
              Foreground="{DynamicResource SecondaryTextBrush}"
              LineHeight="17"
              TextWrapping="Wrap" />
          </StackPanel>

          <Button
            Grid.Column="2"
            Margin="8,-2,0,0"
            VerticalAlignment="Top"
            Click="Close_Click"
            Style="{StaticResource ToastCloseButton}">
            <Path
              Width="11"
              Height="11"
              Data="{icons:Phosphor XBold}"
              Fill="{DynamicResource SecondaryTextBrush}"
              Stretch="Uniform" />
          </Button>
        </Grid>

        <!--  A ação (Reiniciar...) embaixo da mensagem, alinhada com o texto; sem faixa de outra cor  -->
        <Border
          x:Name="ActionsBar"
          Grid.Row="1"
          Padding="60,0,12,12"
          Visibility="Collapsed">
          <Button
            x:Name="ActionButton"
            Height="28"
            MinWidth="88"
            Padding="14,0"
            HorizontalAlignment="Left"
            Click="Action_Click"
            Cursor="Hand">
            <TextBlock
              x:Name="ActionText"
              FontSize="{StaticResource FontSize.Sm}"
              FontWeight="Medium" />
          </Button>
        </Border>

        <!--
          O tempo que falta, numa linha fina no pé do cartão que vai encolhendo. Ela É o relógio do toast: para com o
          mouse em cima e volta quando ele sai, e quem lê vê que dá pra segurar o aviso.
        -->
        <Border
          x:Name="LifeTrack"
          Grid.Row="2"
          Height="2"
          Margin="14,0,14,2"
          Visibility="Collapsed">
          <Border
            x:Name="LifeBar"
            Background="{DynamicResource Accent.TextBrush}"
            CornerRadius="1"
            Opacity="0.5"
            RenderTransformOrigin="0,0.5">
            <Border.RenderTransform>
              <ScaleTransform ScaleX="1" />
            </Border.RenderTransform>
          </Border>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
