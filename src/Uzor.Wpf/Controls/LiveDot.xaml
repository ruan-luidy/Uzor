<UserControl
  x:Class="Uzor.Wpf.Controls.LiveDot"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Name="Self"
  Width="10"
  Height="10"
  Foreground="{StaticResource SuccessBrush}">

  <!--
    A batida está correndo: o miolo respira devagar dentro de um brilho suave, e um anel fino sai dele e some. Anel de
    contorno (não bolinha cheia escalada), senão vira um borrão serrilhado em volta.
  -->
  <UserControl.Resources>
    <Storyboard x:Key="Pulse" RepeatBehavior="Forever">
      <DoubleAnimation
        BeginTime="0:0:0"
        Storyboard.TargetName="Ring"
        Storyboard.TargetProperty="RenderTransform.ScaleX"
        From="1"
        To="2.6"
        Duration="0:0:1.4">
        <DoubleAnimation.EasingFunction>
          <QuarticEase EasingMode="EaseOut" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation
        Storyboard.TargetName="Ring"
        Storyboard.TargetProperty="RenderTransform.ScaleY"
        From="1"
        To="2.6"
        Duration="0:0:1.4">
        <DoubleAnimation.EasingFunction>
          <QuarticEase EasingMode="EaseOut" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation
        Storyboard.TargetName="Ring"
        Storyboard.TargetProperty="Opacity"
        From="0.9"
        To="0"
        Duration="0:0:1.4">
        <DoubleAnimation.EasingFunction>
          <QuadraticEase EasingMode="EaseOut" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="Glow"
        Storyboard.TargetProperty="Opacity"
        Duration="0:0:2.4">
        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
        <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0.25">
          <EasingDoubleKeyFrame.EasingFunction>
            <SineEase EasingMode="EaseInOut" />
          </EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
        <EasingDoubleKeyFrame KeyTime="0:0:2.4" Value="0.55">
          <EasingDoubleKeyFrame.EasingFunction>
            <SineEase EasingMode="EaseInOut" />
          </EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="Core"
        Storyboard.TargetProperty="Opacity"
        Duration="0:0:2.4">
        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
        <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0.75">
          <EasingDoubleKeyFrame.EasingFunction>
            <SineEase EasingMode="EaseInOut" />
          </EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
        <EasingDoubleKeyFrame KeyTime="0:0:2.4" Value="1">
          <EasingDoubleKeyFrame.EasingFunction>
            <SineEase EasingMode="EaseInOut" />
          </EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>
  </UserControl.Resources>

  <Grid>
    <!--  Brilho: a cor da bolinha sumindo pra fora, maior que o controle  -->
    <Ellipse
      x:Name="Glow"
      Margin="-6"
      Fill="{Binding Foreground, ElementName=Self}"
      IsHitTestVisible="False"
      Opacity="0.4">
      <Ellipse.OpacityMask>
        <RadialGradientBrush>
          <GradientStop Offset="0" Color="#B0000000" />
          <GradientStop Offset="0.45" Color="#40000000" />
          <GradientStop Offset="1" Color="Transparent" />
        </RadialGradientBrush>
      </Ellipse.OpacityMask>
    </Ellipse>
    <Ellipse
      x:Name="Ring"
      IsHitTestVisible="False"
      Opacity="0"
      RenderTransformOrigin="0.5,0.5"
      Stroke="{Binding Foreground, ElementName=Self}"
      StrokeThickness="1">
      <Ellipse.RenderTransform>
        <ScaleTransform />
      </Ellipse.RenderTransform>
    </Ellipse>
    <Ellipse x:Name="Core" Fill="{Binding Foreground, ElementName=Self}" />
  </Grid>
</UserControl>
