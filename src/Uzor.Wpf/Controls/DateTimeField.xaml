<UserControl
  x:Class="Uzor.Wpf.Controls.DateTimeField"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:uzor="clr-namespace:Uzor.Wpf"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:controls="clr-namespace:Uzor.Wpf.Controls"
  xmlns:icons="clr-namespace:Uzor.Wpf.Icons"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  x:Name="Root"
  Height="{StaticResource Control.Height}"
  mc:Ignorable="d">

  <UserControl.Resources>
    <!--  A caixa fechada: igual à do SelectField (fundo translúcido, mais claro no hover, azul suave aberta)  -->
    <Style x:Key="DateToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border
              x:Name="Box"
              Padding="10,0"
              Background="{DynamicResource Button.BackgroundBrush}"
              CornerRadius="{StaticResource Radius.Sm}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Button.HoverBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Button.PressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  Atalho de horário: pílula pequena; a que bate com o horário escolhido fica no azul suave  -->
    <Style x:Key="TimeChip" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border
              x:Name="Pill"
              Height="24"
              Padding="8,0"
              Background="{DynamicResource Button.BackgroundBrush}"
              CornerRadius="12">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Button.HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <ToggleButton
      x:Name="Toggle"
      IsHitTestVisible="{Binding IsOpen, ElementName=DropDown, Converter={StaticResource Boolean2BooleanReConverter}}"
      Style="{StaticResource DateToggle}">
      <DockPanel>
        <Path
          Width="13"
          Height="13"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Data="{icons:Phosphor CalendarBlankBold}"
          DockPanel.Dock="Right"
          Fill="{DynamicResource SecondaryTextBrush}"
          Stretch="Uniform" />
        <TextBlock
          x:Name="Label"
          VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </ToggleButton>

    <Popup
      x:Name="DropDown"
      AllowsTransparency="True"
      Closed="DropDown_Closed"
      IsOpen="{Binding IsChecked, ElementName=Toggle}"
      Opened="DropDown_Opened"
      Placement="Custom"
      PlacementTarget="{Binding ElementName=Toggle}"
      StaysOpen="False">
      <!--  O mesmo cartão do SelectField (o menu do Windows 11), com o calendário e o horário dentro  -->
      <Grid
        x:Name="Card"
        Margin="{StaticResource PopupShadowRoom}"
        RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
          <ScaleTransform />
        </Grid.RenderTransform>
        <Border
          Background="{DynamicResource Flyout.BackgroundBrush}"
          CornerRadius="{StaticResource Radius.Lg}"
          Effect="{StaticResource Shadow.Popup}" />
        <Border
          Width="272"
          Padding="12,10,12,12"
          Background="{DynamicResource Flyout.BackgroundBrush}"
          BorderBrush="{DynamicResource Flyout.BorderBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.Lg}">
          <StackPanel>
            <Calendar
              x:Name="Picker"
              Language="pt-BR"
              PreviewMouseUp="Picker_PreviewMouseUp"
              SelectedDatesChanged="Picker_SelectedDatesChanged"
              SelectionMode="SingleDate"
              Style="{StaticResource TerminalCalendar}">
              <!--  As iniciais dos dias e os dias de fora do mês: o #3F3F46 do HandyControl sumia no cartão  -->
              <Calendar.Resources>
                <SolidColorBrush x:Key="ThirdlyTextBrush" Color="#85858C" />
              </Calendar.Resources>
            </Calendar>

            <Border
              Height="1"
              Margin="0,8,0,10"
              Background="{DynamicResource Divider.Brush}" />

            <!--  Horário: hora e minuto separados (digita, setas, rodinha) ou num atalho  -->
            <DockPanel Margin="0,0,0,8">
              <controls:TimeEditor
                x:Name="TimeBox"
                Width="96"
                DockPanel.Dock="Right"
                Edited="TimeBox_Edited" />
              <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Path
                  Width="13"
                  Height="13"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  Data="{icons:Phosphor ClockBold}"
                  Fill="{DynamicResource SecondaryTextBrush}"
                  Stretch="Uniform" />
                <TextBlock
                  VerticalAlignment="Center"
                  FontSize="{StaticResource FontSize.Body}"
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  Text="{x:Static uzor:Texts.Time}" />
              </StackPanel>
            </DockPanel>
            <WrapPanel x:Name="Chips" />

            <DockPanel Margin="0,12,0,0">
              <Button
                Click="Done_Click"
                Content="{x:Static uzor:Texts.Done}"
                DockPanel.Dock="Right"
                Style="{StaticResource Action.Primary.Small}" />
              <Button
                HorizontalAlignment="Left"
                Click="Today_Click"
                Content="{x:Static uzor:Texts.Today}"
                Style="{StaticResource Action.Small}" />
            </DockPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Popup>
  </Grid>
</UserControl>
